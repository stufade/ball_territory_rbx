--!strict
-- Shapes of the match state. Cells are 1-based: k = y * W + x + 1. Element ids are 0-based.
local Rng = require("./Rng")

export type Mask = { boolean }
export type Layer = { number }

export type Ball = {
	e: number,
	x: number,
	y: number,
	px: number,
	py: number,
	dx: number,
	dy: number,
	hp: number,
	alive: boolean,
	respawn: number,
	invuln: number,
	ang: number,
	pang: number,
	charge: number,
	readyT: number,
	stun: number,
	surge: number,
	sx: number,
	sy: number,
	erupt: number,
	ex: number,
	ey: number,
	hole: number,
	hx: number,
	hy: number,
	bigT: number,
	slowT: number,
	hasteT: number,
	phaseT: number,
	rushT: number,
	hitCd: { [number]: number },
	powers: number,
	kills: number,
	redirectAt: number,
	finAim: number,
	dirAt: number?,
	-- nil = bot, otherwise the id of the controlling player
	ctl: string?,
	auto: boolean,
	prompts: boolean,
	name: string,
	pid: string,
}

export type Clone = { x: number, y: number, dx: number, dy: number, untilT: number, e: number }
export type Wave = {
	x: number,
	y: number,
	t: number,
	r: number,
	e: number,
	word: string,
	push: number?,
	dmg: number?,
	stun: number?,
}
export type Bomb = { x: number, y: number, t: number, e: number }
export type Bubble = { x: number, y: number, dx: number, dy: number, untilT: number, e: number }
export type Pod = { x: number, y: number, t: number, e: number }
export type Event = { id: number, kind: string, d: { [string]: any } }
-- [n cells, quiet time, fired, x, y, by]
export type Acc = { n: number, idle: number, fired: boolean, x: number, y: number, by: number }

export type State = {
	W: number,
	H: number,
	N: number,
	cxs: { number },
	cys: { number },
	nbr: { { number } },
	rand: Rng.Rand,
	tick: number,
	t: number,
	owner: { number },
	src: { number },
	L: { [string]: Layer },
	water: Layer,
	ice: Layer,
	bush: Layer,
	burn: Layer,
	toxic: Layer,
	sand: Layer,
	lava: Layer,
	slime: Layer,
	rock: Layer,
	glass: Layer,
	shock: Layer,
	gas: Layer,
	fade: { number },
	burnFlam: Mask,
	flash: { number },
	players: { number },
	balls: { Ball },
	by: { [number]: Ball },
	counts: { [number]: number },
	acc: { [string]: Acc },
	cd: { [string]: number },
	wildNext: number,
	reactions: number,
	seen: { [string]: boolean },
	rxCount: { [string]: number },
	done: boolean,
	final: boolean,
	launched: boolean,
	pods: { Pod },
	nextPrompt: number,
	promptUntil: number,
	events: { Event },
	evId: number,
	slow: number,
	clones: { Clone },
	six: { Wave },
	bombs: { Bomb },
	bubbles: { Bubble },
	round: number,
	finalAt: number,
	pace: { [number]: number },
	ax0: number,
	ay0: number,
	ax1: number,
	ay1: number,
	inA: Mask,
	area: number,
	blob: { number },
	inset: { number },
}

return {}
